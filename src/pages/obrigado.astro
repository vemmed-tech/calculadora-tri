---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Cadastro realizado | Calculadora TRI — VemMED" description="Confirmação de cadastro para a Calculadora TRI da VemMED.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main class="hero thank-you" id="conteudo">
    <span class="decoration-circle" aria-hidden="true"></span>
    <span class="decoration-diamond" aria-hidden="true"></span>
    <div class="thank-you__inner">
      <a class="wordmark" href="/" aria-label="VemMED, início"><img src="/assets/logo-vemmed.svg" alt="VemMED" /></a>
      <p class="page-badge">CALCULADORA TRI</p>
      <h1>Cadastro realizado!</h1>
      <p class="hero__lead">Seus dados foram enviados com sucesso. Obrigado por se cadastrar para acessar a Calculadora TRI da VemMED.</p>
      <div class="hero__access" role="note">
        <span class="hero__access-check" aria-hidden="true">✓</span>
        <div><p class="hero__access-title">Tudo certo com seu cadastro.</p><p class="hero__access-description">Você pode fechar esta página.</p></div>
      </div>
    </div>
  </main>
</BaseLayout>

