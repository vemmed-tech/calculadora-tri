<form id="calculadora-form" class="capture-form" aria-labelledby="panel-title">
  <div class="name-fields">
    <div class="field">
      <label for="nome">Nome <span aria-hidden="true">*</span></label>
      <input id="nome" name="nome" type="text" autocomplete="given-name" maxlength="100" required />
    </div>
    <div class="field">
      <label for="sobrenome">Sobrenome <span aria-hidden="true">*</span></label>
      <input id="sobrenome" name="sobrenome" type="text" autocomplete="family-name" maxlength="150" required />
    </div>
  </div>
  <div class="field">
    <label for="email">E-mail <span aria-hidden="true">*</span></label>
    <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
  </div>
  <div class="field">
    <label for="celular">Celular <span aria-hidden="true">*</span></label>
    <input id="celular" name="celular" type="tel" autocomplete="tel-national" inputmode="tel" placeholder="(11) 99999-9999" maxlength="15" pattern="\(\d{2}\) \d{4,5}-\d{4}" aria-describedby="celular-help" required />
    <span class="sr-only" id="celular-help">Digite DDD e número de celular, com até 11 dígitos.</span>
  </div>
  <div class="form-footer"><button type="submit" class="form-button" disabled>Liberar Acesso</button></div>
  <p class="form-error" role="alert" id="form-error" tabindex="-1"></p>
  <noscript><p class="form-error">Ative o JavaScript do navegador para enviar o cadastro.</p></noscript>
</form>
<script>
  import { attachCalculatorForm } from '../scripts/calculadora-form.js';
  const form = document.querySelector('#calculadora-form');
  if (form) attachCalculatorForm(form);
</script>

